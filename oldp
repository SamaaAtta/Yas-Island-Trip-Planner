    );
}


/* =========================================================
   TIMELINE ITEM
   ========================================================= */

function drawTimelineItem(
    pdf,
    time,
    text,
    detail,
    x,
    y,
    width,
    accent
) {

    const timeWidth = 18;
    const contentX = x + 24;
    const contentWidth = width - 24;

    setText(pdf, accent);

    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(8);

    pdf.text(
        safeText(time),
        x,
        y
    );

    /* Dot */

    setFill(pdf, accent);

    pdf.circle(
        x + 20,
        y - 1.5,
        1.5,
        "F"
    );

    /* Vertical line */

    setStroke(pdf, [215, 222, 226]);

    pdf.setLineWidth(0.4);

    pdf.line(
        x + 20,
        y + 1,
        x + 20,
        y + 14
    );

    /* Main text */

    setText(pdf, [20, 32, 43]);

    pdf.setFont("helvetica", "normal");
    pdf.setFontSize(7.8);

    const lines = splitText(
        pdf,
        safeText(text),
        contentWidth
    );

    pdf.text(
        lines,
        contentX,
        y
    );

    let usedHeight = lines.length * 3.8;

    if (detail) {

        setText(pdf, [91, 107, 120]);

        pdf.setFont("helvetica", "normal");
        pdf.setFontSize(7);

        const detailLines = splitText(
            pdf,
            safeText(detail),
            contentWidth
        );

        pdf.text(
            detailLines,
            contentX,
            y + usedHeight + 1
        );

        usedHeight += detailLines.length * 3.4 + 1;

    }

    return Math.max(
        10,
        usedHeight + 4
    );
}


/* =========================================================
   DAY CARD
   ========================================================= */

function drawDayCard(
    pdf,
    options
) {

    const {
        dayNumber,
        title,
        date,
        image,
        schedule,
        highlightTitle,
        highlightText,
        accent
    } = options;

    const x = 14;
    const width = 182;

    let y = options.y;

    const headerHeight = 17;

    /* Calculate timeline height */

    let timelineHeight = 0;

    schedule.forEach(item => {

        pdf.setFont("helvetica", "normal");
        pdf.setFontSize(7.8);

        const textLines = splitText(
            pdf,
            safeText(item.text),
            158
        );

        let h = textLines.length * 3.8 + 4;

        if (item.detail) {

            pdf.setFontSize(7);

            const detailLines = splitText(
                pdf,
                safeText(item.detail),
                158
            );

            h += detailLines.length * 3.4 + 1;

        }

        timelineHeight += Math.max(10, h);

    });

    const imageHeight = 42;
    const highlightHeight = 28;

    const totalHeight =
        headerHeight +
        imageHeight +
        6 +
        timelineHeight +
        7 +
        highlightHeight +
        8;

    /* Card */

    roundedBox(
        pdf,
        x,
        y,
        width,
        totalHeight,
        4,
        [255,255,255],
        [216,221,225]
    );

    /* Header */

    setText(pdf, accent);

    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(20);

    pdf.text(
        String(dayNumber).padStart(2, "0"),
        x + 5,
        y + 12
    );

    setText(pdf, [20,32,43]);

    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(10.5);

    pdf.text(
        safeText(title),
        x + 25,
        y + 8
    );

    setText(pdf, [91,107,120]);

    pdf.setFont("helvetica", "normal");
    pdf.setFontSize(6.8);

    pdf.text(
        safeText(date),
        x + 25,
        y + 13
    );

    /* Image */

    if (image) {

        addImageCover(
            pdf,
            image,
            x,
            y + headerHeight,
            width,
            imageHeight
        );

    }

    /* Timeline */

    let currentY =
        y +
        headerHeight +
        imageHeight +
        7;

    schedule.forEach(item => {

        const used = drawTimelineItem(
            pdf,
            item.time,
            item.text,
            item.detail,
            x + 6,
            currentY,
            width - 12,
            accent
        );

        currentY += used;

    });

    /* Highlight */

    currentY += 2;

    roundedBox(
        pdf,
        x + 6,
        currentY,
        width - 12,
        highlightHeight,
        3,
        [15,36,56]
    );

    setText(pdf, [240,169,59]);

    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(5.8);

    pdf.text(
        "DAY " + dayNumber + " HIGHLIGHT",
        x + 10,
        currentY + 7
    );

    setText(pdf, [255,255,255]);

    pdf.setFont("helvetica", "bold");
    pdf.setFontSize(8);

    pdf.text(
        safeText(highlightTitle),
        x + 10,
        currentY + 13
    );

    setText(pdf, [200,210,216]);

    pdf.setFont("helvetica", "normal");
    pdf.setFontSize(6.2);

    const highlightLines = splitText(
        pdf,
        safeText(highlightText),
        width - 28
    );

    pdf.text(
        highlightLines.slice(0, 2),
        x + 10,
        currentY + 18
    );

    return y + totalHeight;
}


