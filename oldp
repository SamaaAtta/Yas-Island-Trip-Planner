<script>

/* =========================================================
   IMAGE LOADING
   ========================================================= */

async function imageToDataURL(src) {

    const response = await fetch(src, {
        cache: "no-store"
    });

    if (!response.ok) {
        throw new Error(
            "Image not found: " + src
        );
    }

    const blob = await response.blob();

    return await new Promise((resolve, reject) => {

        const reader = new FileReader();

        reader.onload = () => {
            resolve(reader.result);
        };

        reader.onerror = () => {
            reject(
                new Error(
                    "Could not read image: " + src
                )
            );
        };

        reader.readAsDataURL(blob);

    });
}


/* =========================================================
   IMAGE FORMAT
   ========================================================= */

function getImageFormat(dataURL) {

    if (!dataURL) {
        return "JPEG";
    }

    if (
        dataURL.startsWith("data:image/png") ||
        dataURL.startsWith("data:image/PNG")
    ) {
        return "PNG";
    }

    return "JPEG";
}


/* =========================================================
   TEXT WRAPPING
   ========================================================= */

function splitText(pdf, text, maxWidth) {

    return pdf.splitTextToSize(
        String(text),
        maxWidth
    );
}


/* =========================================================
   SAFE TEXT
   ========================================================= */

function safeText(text) {

    return String(text)
        .replace(/→/g, ">")
        .replace(/←/g, "<")
        .replace(/⇄/g, "<>")
        .replace(/≈/g, "~")
        .replace(/✦/g, "*")
        .replace(/✈/g, "Flight")
        .replace(/–/g, "-")
        .replace(/—/g, "-")
        .replace(/’/g, "'")
        .replace(/“/g, '"')
        .replace(/”/g, '"');

}


/* =========================================================
   BASIC DRAWING HELPERS
   ========================================================= */

function setFill(pdf, rgb) {
    pdf.setFillColor(rgb[0], rgb[1], rgb[2]);
}

function setStroke(pdf, rgb) {
    pdf.setDrawColor(rgb[0], rgb[1], rgb[2]);
}

function setText(pdf, rgb) {
    pdf.setTextColor(rgb[0], rgb[1], rgb[2]);
}

function roundedBox(
    pdf,
    x,
    y,
    w,
    h,
    radius,
    fill,
    stroke = null
) {

    setFill(pdf, fill);

    if (stroke) {
        setStroke(pdf, stroke);
        pdf.roundedRect(
            x,
            y,
            w,
            h,
            radius,
            radius,
            "FD"
        );
    } else {

        pdf.roundedRect(
            x,
            y,
            w,
            h,
            radius,
            radius,
            "F"
        );
    }
}


/* =========================================================
   IMAGE WITH CROP
   ========================================================= */

function addImageCover(
    pdf,
    dataURL,
    x,
    y,
    w,
    h
) {

    if (!dataURL) {
        return;
    }

    const format = getImageFormat(dataURL);

    pdf.addImage(
        dataURL,
        format,
        x,
        y,
        w,
        h
    );
}


/* =========================================================
   PAGE FOOTER
   ========================================================= */

function drawFooter(pdf, pageNumber) {

    setText(pdf, [130, 142, 150]);

    pdf.setFont("helvetica", "bold");
