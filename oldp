<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Yas Island Getaway - PDF Generator</title>

<!-- LOCAL jsPDF ONLY -->
<script src="./jspdf.umd.min.js"></script>

<style>
:root {
    --navy: #0F2438;
    --navy-deep: #081627;
    --sand: #FBF1E1;
    --sand-deep: #F3E2C4;
    --coral: #FF6B4D;
    --gold: #F0A93B;
    --teal: #1FA6A0;
    --teal-deep: #0B4F55;
    --ink: #14202B;
    --cream: #FFFBF4;
    --muted: #5B6B78;
    --line: #D8DDE1;
    --white: #FFFFFF;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background: #DCE1E6;
    color: var(--ink);
    font-family: Arial, Helvetica, sans-serif;
    line-height: 1.45;
}

/* =========================================================
   TOOLBAR
   ========================================================= */

.toolbar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 64px;
    background: var(--navy-deep);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 24px;
    z-index: 9999;
    box-shadow: 0 4px 20px rgba(0,0,0,0.25);
}

.toolbar-title {
    color: white;
    font-weight: 800;
    font-size: 15px;
}

.toolbar-sub {
    color: rgba(255,255,255,0.6);
    font-size: 12px;
    margin-top: 2px;
}

.download-button {
    border: none;
    background: var(--coral);
    color: white;
    padding: 12px 20px;
    border-radius: 999px;
    font-size: 14px;
    font-weight: 800;
    cursor: pointer;
    box-shadow: 0 6px 20px rgba(255,107,77,0.3);
}

.download-button:hover {
    background: #E95539;
}

.download-button:disabled {
    opacity: 0.65;
    cursor: wait;
}

/* =========================================================
   PREVIEW
   ========================================================= */

.preview {
    padding: 94px 20px 50px;
}

.preview-page {
    width: 794px;
    min-height: 1123px;
    background: var(--cream);
    margin: 0 auto 30px;
    box-shadow: 0 15px 45px rgba(0,0,0,0.18);
    position: relative;
    overflow: hidden;
}

.page-inner {
    padding: 36px 40px;
}

.page-footer {
    position: absolute;
    left: 40px;
    right: 40px;
    bottom: 18px;
    display: flex;
    justify-content: space-between;
    color: #8A969E;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.7px;
}

/* =========================================================
   COMMON
   ========================================================= */

.label {
    color: var(--coral);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1px;
    text-transform: uppercase;
}

h2 {
    font-size: 28px;
    line-height: 1.05;
    margin-top: 5px;
}

.card {
    border-radius: 16px;
    overflow: hidden;
}

/* =========================================================
   PAGE 1
   ========================================================= */

.hero {
    height: 275px;
    border-radius: 18px;
    overflow: hidden;
    position: relative;
    color: white;
}

.hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.hero-overlay {
    position: absolute;
    inset: 0;
    background:
        linear-gradient(
            135deg,
            rgba(8,22,39,0.94),
            rgba(8,22,39,0.60),
            rgba(8,22,39,0.20)
        );
}

.hero-content {
    position: absolute;
    left: 28px;
    right: 28px;
    bottom: 26px;
}

.hero-kicker {
    color: var(--gold);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 1.2px;
}

.hero-title {
    font-size: 44px;
    font-weight: 900;
    line-height: 0.95;
    margin-top: 7px;
}

.hero-sub {
    max-width: 500px;
    font-size: 12px;
    color: rgba(255,255,255,0.88);
    margin-top: 12px;
}

.stats {
    display: flex;
    gap: 7px;
    flex-wrap: wrap;
    margin-top: 14px;
}

.stat {
    background: rgba(255,255,255,0.15);
    border: 1px solid rgba(255,255,255,0.25);
    padding: 6px 11px;
    border-radius: 999px;
    font-size: 10px;
}

.stat strong {
    color: white;
}

/* Flights */

.flights {
    background: var(--navy);
    color: white;
    margin-top: 20px;
    padding: 20px;
    border-radius: 16px;
}

.flights .label {
    color: var(--gold);
}

.flight-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px;
    margin-top: 12px;
}

.flight {
    border: 1px solid rgba(255,255,255,0.14);
    background: rgba(255,255,255,0.06);
    padding: 14px;
    border-radius: 11px;
}

.route {
    font-size: 17px;
    font-weight: 900;
}

.flight-time {
    color: rgba(255,255,255,0.76);
    font-size: 10px;
    margin-top: 6px;
}

.flight-tag {
    display: inline-block;
    margin-top: 9px;
    color: var(--gold);
    background: rgba(240,169,59,0.15);
    padding: 4px 8px;
    border-radius: 20px;
    font-size: 8px;
    font-weight: 800;
}

.flight-note {
    color: rgba(255,255,255,0.6);
    font-size: 10px;
    margin-top: 10px;
}

/* Hotel */

.hotel {
    background: linear-gradient(135deg, #0F2438, #1A3A55);
    color: var(--sand);
    margin-top: 20px;
    padding: 20px;
    border-radius: 16px;
    border-top: 3px solid var(--gold);
    border-bottom: 3px solid var(--gold);
}

.hotel-grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 18px;
    margin-top: 12px;
}

.hotel-name {
    color: white;
    font-size: 22px;
    font-weight: 900;
}

.hotel-name span {
    color: var(--gold);
}

.hotel-location {
    color: rgba(251,241,225,0.7);
    font-size: 10px;
    margin-top: 3px;
}

.badge {
    display: inline-block;
    margin-top: 8px;
    padding: 5px 9px;
    background: rgba(240,169,59,0.18);
    color: var(--gold);
    border-radius: 999px;
    font-size: 8px;
    font-weight: 800;
}

.hotel-detail {
    padding: 8px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    font-size: 10px;
}

.hotel-price {
    margin-top: 10px;
    padding: 11px;
    text-align: center;
    border-radius: 10px;
    background: rgba(255,107,77,0.14);
    border: 1px solid rgba(255,107,77,0.28);
}

.hotel-price-number {
    color: white;
    font-size: 22px;
    font-weight: 900;
}

.hotel-price-number span {
    color: var(--gold);
    font-size: 12px;
}

.hotel-price-label {
    color: rgba(251,241,225,0.6);
    font-size: 8px;
    margin-top: 2px;
}

.hotel-image {
    width: 100%;
    height: 205px;
    object-fit: cover;
    border-radius: 11px;
}

/* =========================================================
   DAY PAGES
   ========================================================= */

.day-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    border-bottom: 2px solid var(--line);
    padding-bottom: 14px;
}

.day-header-right {
    font-size: 11px;
    font-weight: 800;
    color: var(--muted);
}

.day-card {
    margin-top: 18px;
    border-radius: 16px;
    overflow: hidden;
    border: 1px solid var(--line);
    background: white;
}

.day-card-header {
    display: flex;
    align-items: center;
    gap: 13px;
    padding: 15px 17px;
}

.day-number {
    font-size: 30px;
    font-weight: 900;
    color: var(--coral);
    line-height: 1;
}

.day-card:nth-child(3) .day-number {
    color: var(--teal-deep);
}

.day-card:nth-child(4) .day-number {
    color: #C77E1B;
}

.day-title {
    font-size: 17px;
    font-weight: 900;
}

.day-date {
    color: var(--muted);
    font-size: 10px;
    margin-top: 2px;
}

.day-image {
    width: 100%;
    height: 190px;
    object-fit: cover;
}

.day-content {
    padding: 15px 17px 17px;
}

/* Timeline */

.timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
}

.timeline-item {
    display: grid;
    grid-template-columns: 58px 1fr;
    position: relative;
    min-height: 51px;
}

.timeline-time {
    color: var(--coral);
    font-weight: 900;
    font-size: 11px;
    padding-top: 1px;
}

.timeline-item:nth-child(2n) .timeline-time {
    color: var(--teal-deep);
}

.timeline-line {
    position: absolute;
    left: 50px;
    top: 5px;
    bottom: -5px;
    width: 1px;
    background: #D7DEE2;
}

.timeline-dot {
    position: absolute;
    left: 46px;
    top: 2px;
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--coral);
    border: 2px solid white;
    box-shadow: 0 0 0 1px var(--coral);
}

.timeline-item:nth-child(2n) .timeline-dot {
    background: var(--teal);
    box-shadow: 0 0 0 1px var(--teal);
}

.timeline-text {
    padding-left: 16px;
    padding-bottom: 11px;
    font-size: 10px;
    line-height: 1.45;
}

.timeline-text strong {
    color: var(--ink);
}

.detail {
    display: block;
    color: var(--muted);
    font-size: 9px;
    margin-top: 2px;
}

.highlight {
    margin-top: 14px;
    display: grid;
    grid-template-columns: 130px 1fr;
    gap: 14px;
    background: var(--navy);
    color: white;
    padding: 12px;
    border-radius: 12px;
}

.highlight img {
    width: 130px;
    height: 90px;
    object-fit: cover;
    border-radius: 8px;
}

.highlight-label {
    color: var(--gold);
    font-size: 8px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.8px;
}

.highlight-title {
    font-size: 14px;
    font-weight: 900;
    margin-top: 3px;
}

.highlight-text {
    color: rgba(255,255,255,0.72);
    font-size: 9px;
    margin-top: 5px;
    line-height: 1.4;
}

.note {
    margin-top: 12px;
    border-left: 3px solid var(--gold);
    background: rgba(240,169,59,0.10);
    padding: 8px 10px;
    font-size: 9px;
    color: #4A5963;
}

/* =========================================================
   PAGE 4
   ========================================================= */

.budget {
    background: var(--navy-deep);
    color: var(--sand);
    padding: 23px;
    border-radius: 16px;
}

.budget .label {
    color: var(--gold);
}

.budget h2 {
    color: white;
}

.budget-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 10px;
    margin-top: 15px;
}

.budget-card {
    padding: 12px;
    border-radius: 10px;
    border: 1px solid rgba(255,255,255,0.13);
    background: rgba(255,255,255,0.05);
}

.budget-label {
    color: rgba(251,241,225,0.6);
    font-size: 8px;
    font-weight: 800;
}

.budget-amount {
    color: white;
    font-size: 17px;
    font-weight: 900;
    margin-top: 3px;
}

.budget-amount span {
    color: var(--gold);
    font-size: 9px;
}

.budget-detail {
    color: rgba(251,241,225,0.5);
    font-size: 8px;
    margin-top: 3px;
}

.total {
    margin-top: 12px;
    padding: 13px 16px;
    border-radius: 10px;
    background: linear-gradient(
        120deg,
        rgba(255,107,77,0.2),
        rgba(31,166,160,0.2)
    );
    border: 1px solid rgba(255,255,255,0.16);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.total-label {
    color: white;
    font-size: 11px;
    font-weight: 900;
}

.total-sub {
    color: rgba(251,241,225,0.65);
    font-size: 8px;
    margin-top: 2px;
}

.total-number {
    color: white;
    font-size: 25px;
    font-weight: 900;
}

.shopping {
    color: rgba(251,241,225,0.6);
    font-size: 9px;
    margin-top: 9px;
}

.tips {
    margin-top: 22px;
}

.tip-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
    margin-top: 13px;
}

.tip {
    background: white;
    border: 1px solid var(--line);
    border-radius: 11px;
    padding: 13px;
}

.tip h3 {
    font-size: 11px;
    font-weight: 900;
}

.tip p {
    margin-top: 4px;
    color: var(--muted);
    font-size: 9px;
    line-height: 1.45;
}

.final-message {
    text-align: center;
    margin-top: 30px;
}

.final-message strong {
    font-size: 14px;
}

.final-message p {
    color: var(--muted);
    font-size: 9px;
    margin-top: 4px;
}

/* =========================================================
   MOBILE PREVIEW
   ========================================================= */

@media (max-width: 850px) {

    .toolbar {
        height: auto;
        min-height: 64px;
        padding: 10px 12px;
    }

    .toolbar-sub {
        display: none;
    }

    .download-button {
        padding: 10px 14px;
        font-size: 12px;
    }

    .preview {
        padding-top: 85px;
        overflow-x: auto;
    }

    .preview-page {
        transform-origin: top center;
    }
}
</style>
</head>

